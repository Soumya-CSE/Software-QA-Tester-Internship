{
  "info": {
    "name": "QA Week3 API Testing - Reqres",
    "_postman_id": "c4a8d2f1-7b6e-4a9c-8d21-week3api",
    "description": "Week 3 API testing project covering GET, POST, PUT and DELETE operations using the Reqres public test API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - List Users (page 1)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users?page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "users"],
          "query": [
            {
              "key": "page",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code should be 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Users data is available', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.be.an('array');",
              "    pm.expect(json.data.length).to.be.above(0);",
              "});",
              "",
              "pm.test('Requested page is correct', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.page).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Single User (id=3)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/3",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "3"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code should be 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Correct user is returned', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.id).to.eql(3);",
              "});",
              "",
              "pm.test('Email field exists', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.have.property('email');",
              "});",
              "",
              "pm.test('Response time is below 3 seconds', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Create New User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Soumya Kanti\",\n  \"job\": \"Software QA Tester\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": ["{{base_url}}"],
          "path": ["api", "users"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code should be 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('New user ID and creation time exist', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('id');",
              "    pm.expect(json).to.have.property('createdAt');",
              "});",
              "",
              "pm.test('User details are returned correctly', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.name).to.eql('Soumya Kanti');",
              "    pm.expect(json.job).to.eql('Software QA Tester');",
              "});",
              "",
              "pm.collectionVariables.set('new_user_id', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT - Update User",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Soumya Kanti\",\n  \"job\": \"QA Automation Tester\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/3",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "3"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code should be 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Updated job is correct', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.job).to.eql('QA Automation Tester');",
              "});",
              "",
              "pm.test('Updated timestamp is present', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('updatedAt');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE - Delete User",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/users/3",
          "host": ["{{base_url}"],
          "path": ["api", "users", "3"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code should be 204', function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test('Response body should be empty', function () {",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://reqres.in"
    },
    {
      "key": "new_user_id",
      "value": ""
    }
  ]
}
